{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/access.mjs": {
      "includeFiles": "private/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
